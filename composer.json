{
    "name": "rushing/laravel-data-oscal",
    "description": "A boundary projector marrying spatie/laravel-data DTOs to NIST OSCAL documents: a typed registry + dispatch-by-Data-class projector and a dereferencer-style reader that round-trip a Data object to an OSCAL node (Catalog / Profile / Component-Definition / Assessment-Results / POA&M) at the edge. A neutral open foundation leaf \u2014 domain-agnostic, names no concrete compliance vocabulary.",
    "keywords": [
        "laravel",
        "oscal",
        "compliance",
        "security",
        "laravel-data",
        "boundary-projection"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Stephen Rushing",
            "email": "stephenr85@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "rushing/laravel-popcorn": "dev-main",
        "rushing/php-popcorn": "dev-main",
        "spatie/laravel-data": "^4.0|^5.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0",
        "wikimedia/composer-merge-plugin": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Rushing\\DataOscal\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rushing\\DataOscal\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        },
        "laravel": {
            "providers": [
                "Rushing\\DataOscal\\ServiceProvider"
            ]
        },
        "merge-plugin": {
            "include": [
                "composer.local.json"
            ]
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/stephenr85/laravel-popcorn.git"
        },
        {
            "type": "git",
            "url": "https://github.com/stephenr85/php-popcorn.git"
        }
    ],
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "wikimedia/composer-merge-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "test": "vendor/bin/pest",
        "pint": "@php -d memory_limit=512M vendor/bin/pint"
    }
}
